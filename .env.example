# AI Provider: "gemini" (Google) or "openrouter" (OpenAI-compatible API)
AI_PROVIDER=openrouter

# --- OpenAI-compatible API (OpenCode / OpenRouter) ---
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=gpt-5.6-luna
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2000

