# Gemini API key used by google-genai / Google ADK.
GOOGLE_API_KEY=

# All roles default to gemini-3.6-flash. Override individually when needed.
GEMINI_DIRECTOR_MODEL=gemini-3.6-flash
GEMINI_REVIEWER_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_EDITOR_MODEL=gemini-3.6-flash
GEMINI_TRIM_REFINER_MODEL=gemini-3.6-flash
